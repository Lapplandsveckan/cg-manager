{
  "private": true,
  "version": "2.42.0",
  "name": "@cg-manager/server",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "package": "node .lappis/scripts/package.js",
    "gen:web-lib-types": "node .lappis/scripts/generate-web-lib-types.js",
    "start": "cd test && ts-node ../src/index.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^5.0.8",
    "@lappis/cg-manager": "*",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@mui/system": "5.18.0",
    "@sentry/node-core": "^10.73.0",
    "@sentry/react": "10.73.0",
    "@tanstack/react-query": "^5",
    "adm-zip": "^0.6.0",
    "babel-loader": "^10.1.1",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.2",
    "fuse.js": "^7.4.2",
    "i18next": "^26.4.0",
    "lnk": "^1.1.0",
    "memfs": "^4.68.2",
    "moment": "^2.29.4",
    "mui-color-input": "2.0.3",
    "next": "^16.3.3",
    "no-try": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^17.0.12",
    "rest-exchange-protocol": "^0.0.19",
    "rest-exchange-protocol-client": "^0.0.15",
    "webpack": "^5.90.3",
    "werift": "^0.24.4",
    "ws": "^8.12.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.21",
    "@types/node": "^22.0.0",
    "@types/pouchdb-node": "^6.1.4",
    "@types/react": "^19.2.18",
    "@types/xml2js": "^0.4.14",
    "@yao-pkg/pkg": "^6.1.1",
    "ts-node": "^10.9.1"
  },
  "pkg": {
    "options": [
      "experimental-vm-modules",
      "unhandled-rejections=warn"
    ],
    "scripts": [
      "dist/web/*.js",
      "dist/web/.next/**/*.js",
      "../../node_modules/react-i18next/**/*.{js,cjs,mjs}",
      "../../node_modules/i18next/**/*.{js,cjs,mjs}",
      "../../node_modules/html-parse-stringify/**/*.{js,cjs,mjs}",
      "../../node_modules/@sentry/core/build/cjs/**/*.js",
      "../../node_modules/@sentry/node-core/build/cjs/**/*.js",
      "../../node_modules/import-in-the-middle/**/*.js",
      "../../node_modules/module-details-from-path/**/*.js"
    ],
    "assets": [
      "dist/web/.next/**/*",
      "dist/web/public/**/*",
      "dist/plugins/internal/**/ui/*.jsx",
      "../../node_modules/**/*",
      "!../../node_modules/@cg-manager/**"
    ],
    "targets": [
      "node22-linux-x64"
    ],
    "outputPath": "out"
  },
  "bin": {
    "manager": "./dist/index.js"
  }
}
